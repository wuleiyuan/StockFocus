# StockFocus 环境配置模板
# 复制此文件为 .env 并填入实际值

# ===================
# 数据库配置 (必需)
# ===================
POSTGRES_DB=stock_data
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ===================
# 应用配置
# ===================
LOG_LEVEL=INFO
REFRESH_INTERVAL=10
BATCH_SIZE=50

# ===================
# 网络配置
# ===================
NO_PROXY=*
REQUEST_TIMEOUT=5
RETRY_COUNT=3

# ===================
# 估值配置 (可选)
# ===================
DEFAULT_PE=15
GOLDEN_PIT_THRESHOLD=-15
OVERVALUED_THRESHOLD=20

# ===================
# 交易成本配置 (可选)
# ===================
TRANSACTION_FEE_RATE=0.001
STAMP_TAX_RATE=0.001
SLIPPAGE_RATE=0.002

# ===================
# 缓存配置 (可选)
# ===================
# STOCK_DATA_TTL=60
# AI_REPORT_TTL=3600
